O =         O,
Ind =       Ind,
P =         P,
E =         E,
H =         H,
cum =       cum,
details =   TRUE)
resHF <- proxyiv(y =         y,
O =         O,
Z =         Z,
Ind =       Ind,
recursive = FALSE,
P =         P,
E =         E,
H =         H,
cum =       cum,
details =   TRUE)
resHFrec <- proxyiv(y =      y,
O =         O,
Z =         Z,
Ind =       Ind,
recursive = TRUE,
P =         P,
E =         E,
H =         H,
cum =       cum,
details =   TRUE)
