#-------------------------------------------------------------------------------
yData <- ts_c(IndE, FFR, IR3Mfed, IR6Mfed, IR1Yfed, IR2Yfed, IR3Yfed, IR5Yfed, IR7Yfed, IR10Yfed, IR30Yfed,
IRSTfed, IRMTfed, IRLTfed,
NEER, Stocks, Spread, VIX, TRSkew, SW)
